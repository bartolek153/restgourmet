Ref restaurant.orders_tenant_id_fk {
	restaurant.orders.tenant_id < shared.tenants.id [ delete: no action, on update: no action ]
}

Ref restaurant.order_lines_order_id_fk {
	restaurant.order_lines.order_id < restaurant.orders.id [ delete: no action, on update: no action ]
}

Ref restaurant.tables_tenant_id_fk {
	restaurant.tables.tenant_id < shared.tenants.id [ delete: no action, on update: no action ]
}

Ref restaurant.orders_table_num_fk {
	restaurant.orders.table_num < restaurant.tables.number [ delete: no action, on update: no action ]
}

Ref restaurant.order_lines_product_id_fk {
	restaurant.order_lines.product_id < wh.products.id [ delete: no action, on update: no action ]
}

Ref wh.suppliers_id_fk {
	wh.inventory_positions.purchase_supplier_id < wh.suppliers.id [ delete: no action, on update: no action ]
}

Ref fk_proj.tasks_project_id_proj.projects {
	proj.tasks.project_id > proj.projects.id [ delete: no action, on update: no action ]
}

Ref fk_proj.task_dependencies_task_id_proj.tasks {
	proj.task_dependencies.task_id - proj.tasks.id [ delete: no action, on update: no action ]
}

Ref fk_proj.project_members_project_id_proj.projects {
	proj.project_members.project_id > proj.projects.id [ delete: no action, on update: no action ]
}

Ref fk_proj.project_members_user_id_auth.users {
	proj.project_members.user_id > auth.users.id [ delete: no action, on update: no action ]
}

Ref fk_proj.resource_capacity_project_id_proj.projects {
	proj.resource_capacity.project_id - proj.projects.id [ delete: no action, on update: no action ]
}

Ref fk_proj.financials_project_id_proj.projects {
	proj.financials.project_id > proj.projects.id [ delete: no action, on update: no action ]
}

Ref fk_proj.payback_data_project_id_proj.projects {
	proj.payback_data.project_id > proj.projects.id [ delete: no action, on update: no action ]
}