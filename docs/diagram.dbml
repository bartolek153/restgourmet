}

Ref hr.employee_days_off_employee_id_fk {
	hr.employee_days_off.employee_id < hr.employees.id [ delete: no action, on update: no action ]
}

Ref hr.employee_days_off_reason_id_fk {
	hr.employee_days_off.reason_id < hr.employee_day_off_reasons.id [ delete: no action, on update: no action ]
}

Ref hr.employee_day_off_reasons_tenant_id_fk {
	hr.employee_day_off_reasons.tenant_id < shared.tenants.id [ delete: no action, on update: no action ]
}

Ref hr.employee_notifications_employee_id_fk {
	hr.employee_notifications.employee_id < hr.employees.id [ delete: no action, on update: no action ]
}

Ref hr.employee_roles_tenant_id_fk {
	hr.employee_roles.tenant_id < shared.tenants.id [ delete: no action, on update: no action ]
}

Ref hr.employee_attendances_tenant_id_fk {
	hr.employee_attendances.tenant_id < shared.tenants.id [ delete: no action, on update: no action ]
}

Ref hr.work_schedules_tenant_id_fk {
	hr.work_schedules.tenant_id < shared.tenants.id [ delete: no action, on update: no action ]
}

Ref hr.tasks_tenant_id_fk {
	hr.activities.tenant_id < shared.tenants.id [ delete: no action, on update: no action ]
}

Ref hr.activity_tasks_activity_id_fk {
	hr.activity_tasks.activity_id < hr.activities.id [ delete: no action, on update: no action ]
